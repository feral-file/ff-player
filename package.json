{
  "name": "ff-player",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "bash ./scripts/lint-changed.sh",
    "lint:all": "eslint .",
    "post-implement-check": "bash ./scripts/lint-changed.sh --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run build"
  },
  "dependencies": {
    "@sentry/nextjs": "^8.22.0",
    "axios": "1.14.0",
    "clsx": "^2.1.1",
    "core-js": "^3.38.1",
    "detect-browser": "^5.3.0",
    "hls.js": "^1.5.14",
    "next": "^14.2.29",
    "react": "^18",
    "react-dom": "^18",
    "reconnecting-websocket": "^4.4.0",
    "sass": "^1.77.8",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.9.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.9.0",
    "eslint-config-next": "^14.2.5",
    "eslint-formatter-rdjson": "^1.0.6",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "eslint": "^9.9.0"
  }
