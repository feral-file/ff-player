{
  "contracts": {
    "mintPairingDisplay": {
      "version": 1,
      "requestKey": "request",
      "states": [
        "pairing_code",
        "request_received",
        "creating_token",
        "hidden"
      ],
      "acceptedResponse": {
        "ok": true
      }
    },
    "setupDisplay": {
      "version": 1,
      "requestKey": "request",
      "states": [
        "softap_qr",
        "joining",
        "join_failed",
        "updating",
        "claim_qr",
        "factory_reset",
        "ready",
        "hidden"
      ],
      "stateFields": {
        "softap_qr": {
          "required": ["ssid"],
          "optional": ["password"]
        },
        "join_failed": {
          "optional": ["reason"]
        },
        "updating": {
          "optional": ["progress"]
        },
        "claim_qr": {
          "required": ["url"]
        }
      },
      "notes": "Requests missing a required field for their state are rejected with {ok:false}. progress must be a finite number. The player renders overlay-driving commands (mintPairingDisplay, setupDisplay) without arbitration, so the controller must keep at most one non-hidden at a time.",
      "acceptedResponse": {
        "ok": true
      }
    }
  }
}
